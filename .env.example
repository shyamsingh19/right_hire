# ── LLM Backend ──────────────────────────────────────────────────────────────
# Choose ONE backend: local | groq | openai
LLM_BACKEND=local

# -- Option A: Local Ollama (default) -----------------------------------------
# Point to localhost or a remote GPU machine
OLLAMA_URL=http://localhost:11434
JUDGE_MODEL=qwen2.5:7b
# To use a remote GPU:  OLLAMA_URL=http://192.168.75.107:11434

# -- Option B: Groq (fast cloud inference, free tier) -------------------------
# LLM_BACKEND=groq
# GROQ_API_KEY=gsk_...
# JUDGE_MODEL=llama-3.1-8b-instant

# -- Option C: OpenAI ----------------------------------------------------------
# LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# JUDGE_MODEL=gpt-4o-mini

# ── Embeddings ────────────────────────────────────────────────────────────────
# local: uses sentence-transformers (CPU ok)
# BAAI/bge-m3 is best; falls back to all-MiniLM-L6-v2 if unavailable
EMBED_MODEL=BAAI/bge-m3
JUDGE_MAX_TOKENS=300

# ── Database & Queue ──────────────────────────────────────────────────────────
# Host path: docker-compose remaps MySQL to :3307 to avoid clashing with a native
# mysql install — use 3306 here only if MySQL is reachable directly on the default port.
DATABASE_URL=mysql+pymysql://ats:ats@localhost:3307/ats
STORAGE_DIR=./storage

# ── API ───────────────────────────────────────────────────────────────────────
# Comma-separated allowlist for browser clients (the Reflex UI, or any other frontend).
# Leave as "*" for local dev; set to your real origin(s) before a public deploy.
CORS_ORIGINS=*
MAX_UPLOAD_MB=10
# Dev convenience: auto-creates tables on startup instead of requiring `alembic upgrade head`
# first. Set to false once Alembic manages this deployment's schema.
AUTO_CREATE_TABLES=true
# ── Redis — choose ONE option ─────────────────────────────────────────────────
# Option A (default): Local / self-hosted Redis. `docker compose up -d redis` maps this
# to host port 6380 (see docker-compose.yml); inside docker-compose, app/worker override
# this to redis://redis:6379/0 automatically, so this line only matters for the host path.
REDIS_URL=redis://localhost:6380/0

# Option B: Upstash Redis (recommended for cloud deployments) — uncomment both lines
# below and get the values from https://console.upstash.com → your database → REST API.
# When set, these take priority over REDIS_URL (see Settings.effective_redis_url).
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-token>

# ── Billing ───────────────────────────────────────────────────────────────────
# Deliberately manual for MVP — no card data or webhooks touch this app. See app/api/billing.py.
SIGNUP_FREE_CREDITS=3
# Optional: link to an external payment page (Stripe Payment Link, PayPal.me, etc.)
# shown to users who ask for more credits via POST /billing/request-credits.
PAYMENT_LINK_URL=
# Shared secret for POST /billing/admin/grant-credits — the endpoint you call yourself
# after manually confirming a payment. Leave blank to disable it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
