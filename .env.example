# ── LLM Backend ──────────────────────────────────────────────────────────────
# Choose ONE backend: local | groq | openai | cerebras
LLM_BACKEND=local

# -- Option A: Local Ollama (default) -----------------------------------------
# Point to localhost or a remote GPU machine
OLLAMA_URL=http://localhost:11434
JUDGE_MODEL=qwen2.5:7b
# To use a remote GPU:  OLLAMA_URL=http://192.168.75.107:11434

# -- Option B: Groq (fast cloud inference, free tier) -------------------------
# LLM_BACKEND=groq
# GROQ_API_KEY=gsk_...
# CASCADE_MODEL=llama-3.3-70b-versatile

# -- Option C: OpenAI ----------------------------------------------------------
# LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# -- Option D: Cerebras (fast cloud inference) ---------------------------------
# LLM_BACKEND=cerebras
# CEREBRAS_API_KEY=csk-...
# CEREBRAS_MODEL=gemma-4-31b

# ── Embeddings ────────────────────────────────────────────────────────────────
# local: uses sentence-transformers (CPU ok)
# BAAI/bge-m3 is best; falls back to all-MiniLM-L6-v2 if unavailable
EMBED_MODEL=BAAI/bge-m3
JUDGE_MAX_TOKENS=300
# Hard caps for prompt inputs — raise with care (LLM context/cost tradeoff).
RESUME_MAX_CHARS=6000
JD_MAX_CHARS=4000
PARSE_RESUME_MAX_TOKENS=512
PARSE_JD_MAX_TOKENS=2048

# ── Database & Queue ──────────────────────────────────────────────────────────
# filess.io hosted MySQL — replace <PASSWORD> with your actual password
DATABASE_URL=mysql+pymysql://right_hire_stringpole:<PASSWORD>@o6hwcr.h.filess.io:61001/right_hire_stringpole
STORAGE_DIR=./storage

# ── API ───────────────────────────────────────────────────────────────────────
# Comma-separated allowlist for browser clients (the Reflex UI, or any other frontend).
# Leave as "*" for local dev; set to your real origin(s) before a public deploy.
CORS_ORIGINS=*
MAX_UPLOAD_MB=10

# ── Reflex UI (ui/rxconfig.py) — separate from the API's CORS_ORIGINS above ─────
# The Reflex UI runs its own backend (state/websocket server) independent of this
# FastAPI app. If the UI is opened from anywhere other than the machine serving it
# (a LAN IP, a different host, behind a reverse proxy/tunnel), set REFLEX_API_URL to
# that publicly-reachable http(s)://host:port — otherwise the browser's websocket
# connection to the Reflex backend fails/403s. Leave unset for plain local dev.
# REFLEX_API_URL=http://your-host:8000
# REFLEX_CORS_ORIGINS=*
# Dev convenience: auto-creates tables on startup instead of requiring `alembic upgrade head`
# first. Set to false once Alembic manages this deployment's schema.
AUTO_CREATE_TABLES=true
# ── Redis — choose ONE option ─────────────────────────────────────────────────
# Option A (local development, the safe default): a plain Redis container.
#   docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0

# Option B (deployment): Upstash Redis — uncomment BOTH lines and fill in real values
# from https://console.upstash.com → your database → REST API. Once both are set they
# take priority over REDIS_URL above (see Settings.effective_redis_url). Placeholder
# values containing "<" are ignored, so a half-filled config falls back to REDIS_URL
# instead of silently pointing the queue at a host that doesn't exist.
# UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-token>

# ── Billing ───────────────────────────────────────────────────────────────────
# Deliberately manual for MVP — no card data or webhooks touch this app. See app/api/billing.py.
SIGNUP_FREE_CREDITS=3
# Optional: link to an external payment page (Stripe Payment Link, PayPal.me, etc.)
# shown to users who ask for more credits via POST /billing/request-credits.
PAYMENT_LINK_URL=
# Shared secret for POST /billing/admin/grant-credits — the endpoint you call yourself
# after manually confirming a payment. Leave blank to disable it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Shown to users with a pending credit request so they have somewhere to follow up.
# SUPPORT_CONTACT=support@example.com
