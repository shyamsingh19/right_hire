# ── LLM Backend ──────────────────────────────────────────────────────────────
# Choose ONE backend: local | groq | openai
LLM_BACKEND=local

# -- Option A: Local Ollama (default) -----------------------------------------
# Point to localhost or a remote GPU machine
OLLAMA_URL=http://localhost:11434
JUDGE_MODEL=qwen2.5:7b
# To use a remote GPU:  OLLAMA_URL=http://192.168.75.107:11434

# -- Option B: Groq (fast cloud inference, free tier) -------------------------
# LLM_BACKEND=groq
# GROQ_API_KEY=gsk_...
# JUDGE_MODEL=llama-3.1-8b-instant

# -- Option C: OpenAI ----------------------------------------------------------
# LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# JUDGE_MODEL=gpt-4o-mini

# ── Embeddings ────────────────────────────────────────────────────────────────
# local: uses sentence-transformers (CPU ok)
# BAAI/bge-m3 is best; falls back to all-MiniLM-L6-v2 if unavailable
EMBED_MODEL=BAAI/bge-m3
JUDGE_MAX_TOKENS=300

# ── Database & Queue ──────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://ats:ats@localhost:3306/ats
STORAGE_DIR=./storage

# ── API ───────────────────────────────────────────────────────────────────────
# Comma-separated allowlist for browser clients (the Reflex UI, or any other frontend).
# Leave as "*" for local dev; set to your real origin(s) before a public deploy.
CORS_ORIGINS=*
MAX_UPLOAD_MB=10
# Dev convenience: auto-creates tables on startup instead of requiring `alembic upgrade head`
# first. Set to false once Alembic manages this deployment's schema.
AUTO_CREATE_TABLES=true
# ── Redis — choose ONE option ─────────────────────────────────────────────────
# Option A: Upstash Redis (recommended for cloud deployments)
# Get these from https://console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# Option B: Local / self-hosted Redis (comment out Option A to use this)
# REDIS_URL=redis://localhost:6379/0
